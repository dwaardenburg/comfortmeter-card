{
  "name": "comfortmeter-card",
  "version": "0.1.0",
  "private": true,
  "description": "A Home Assistant card that shows temperature and humidity as a classic two-needle comfortmeter, in the style of Home Assistant's thermostat card.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/dwaardenburg/comfortmeter-card.git"
  },
  "scripts": {
    "build": "rspack build --mode production",
    "dev": "rspack build --mode development --watch",
    "preview": "node preview/serve.mjs",
    "lint:eslint": "eslint \"src/**/*.ts\" \"test/**/*.ts\" \"preview/**/*.ts\" --cache --cache-location=node_modules/.cache/eslint/.eslintcache --max-warnings=0",
    "lint:prettier": "prettier . --cache --check",
    "lint:types": "tsc",
    "lint:lit": "lit-analyzer \"src/**/*.ts\" --maxWarnings 0",
    "lint": "pnpm run lint:eslint && pnpm run lint:prettier && pnpm run lint:types && pnpm run lint:lit",
    "format": "eslint \"src/**/*.ts\" \"test/**/*.ts\" \"preview/**/*.ts\" --fix && prettier . --cache --write",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.21.0",
  "dependencies": {
    "lit": "^3.3.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@rspack/cli": "^2.3.3",
    "@rspack/core": "^2.3.3",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-lit": "^2.3.1",
    "eslint-plugin-lit-a11y": "^5.1.3",
    "eslint-plugin-unused-imports": "^4.4.1",
    "eslint-plugin-wc": "^3.1.0",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "lit-analyzer": "^2.0.3",
    "prettier": "^3.10.1",
    "ts-lit-plugin": "^2.0.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  }
}
